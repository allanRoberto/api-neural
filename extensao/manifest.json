{
    "manifest_version": 3,
    "name": "RevesBot WS Helper",
    "version": "1.0.0",
    "description": "Hooka o WebSocket da mesa e permite enviar apostas via postMessage.",
    "permissions": [],
    "host_permissions": [
      "<all_urls>"
    ],
    "content_scripts": [
      {
        "matches": [
          "<all_urls>"
        ],
        "js": ["ws-sniffer.js"],
        "run_at": "document_idle",
        "all_frames": true
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["injected.js"],
        "matches": ["<all_urls>"]
      }
    ]
  }